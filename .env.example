# Copiá este archivo a .env y completá los valores.

# Base de datos MySQL
# Local:
#   DATABASE_URL="mysql://usuario:clave@localhost:3306/hacecafe"
# Aiven: pegá el "Service URI" de la consola (ya trae el puerto y ssl-mode=REQUIRED) y
# cambiá el nombre de la base (defaultdb) por la tuya. connection_limit evita agotar las
# conexiones del plan gratuito cuando varias personas usan la misma base.
DATABASE_URL="mysql://avnadmin:CLAVE@HOST.aivencloud.com:PUERTO/NOMBRE_DE_TU_BASE?ssl-mode=REQUIRED&connection_limit=3"

# Texto largo y aleatorio. El servidor no arranca sin esto.
JWT_SECRET="cambia-esto-por-un-texto-largo-y-aleatorio"

PORT=3001

# URL del frontend (para CORS). localhost:5173 y la de Vercel ya están permitidas.
FRONTEND_URL="http://localhost:5173"

# ── Opcionales ──
# Permite crear cuentas sin ser dueño (solo para crear la primera cuenta y borrar después)
# REGISTRO_ABIERTO=true
# Si el frontend todavía no envía el token por socket, esto vuelve al comportamiento anterior
# SOCKET_ABIERTO=true
# Datos del dueño que crea "npm run seed" (si no hay contraseña, se genera una y se muestra)
# SEED_DUENO_EMAIL=dueno@hacecafe.com
# SEED_DUENO_PASSWORD=
