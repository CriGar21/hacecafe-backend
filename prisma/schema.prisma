generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id            Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(80)
  icono         String?    @db.VarChar(10)
  activa        Boolean    @default(true)
  ordenDisplay  Int?
  productos     Producto[]

  @@map("categorias")
}

model Producto {
  id                 Int       @id @default(autoincrement())
  categoriaId        Int
  nombre             String    @db.VarChar(120)
  descripcion        String?   @db.Text
  precio             Decimal   @db.Decimal(10, 2)
  precioCosto        Decimal?  @db.Decimal(10, 2)
  disponible         Boolean   @default(true)
  imagenUrl          String?   @db.VarChar(300)
  stockActual        Int       @default(0)
  stockMinimo        Int       @default(5)
  tiempoPreparacion  Int?
  ordenDisplay       Int?
  creadoEn           DateTime  @default(now())
  actualizadoEn      DateTime  @updatedAt

  categoria          Categoria @relation(fields: [categoriaId], references: [id])
  items              ItemPedido[]

  @@index([disponible])
  @@index([categoriaId])
  @@map("productos")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  password     String    @db.VarChar(255)
  rol          Rol       @default(EMPLEADO)
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())
  pedidos      Pedido[]
  fichajes     Fichaje[]
  @@map("usuarios")
}


model Fichaje {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  tipo       String   @db.VarChar(10)
  latitud    Float
  longitud   Float
  distanciaM Int?
  creadoEn   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuarioId, creadoEn])
  @@index([creadoEn])
  @@map("fichajes")
}

model Pedido {
  id                    Int           @id @default(autoincrement())
  numero                Int           @unique
  usuarioId             Int
  mesa                  String?       @db.VarChar(20)
  estado                EstadoPedido  @default(PENDIENTE)
  cobrado               Boolean       @default(false)
  metodoPago            String?       @db.VarChar(30)
  subtotal              Decimal       @default(0) @db.Decimal(10, 2)
  descuentoPorcentaje   Decimal       @default(0) @db.Decimal(5, 2)
  descuentoMonto        Decimal       @default(0) @db.Decimal(10, 2)
  descuentoMotivo       String?       @db.VarChar(160)
  descuentoOrigen       String?       @db.VarChar(30)
  descuentoCodigo       String?       @db.VarChar(80)
  total                 Decimal       @db.Decimal(10, 2)
  notas                 String?       @db.Text
  clienteToken          String?       @unique @db.VarChar(80)
  juegoJugado           Boolean       @default(false)
  juegoPremio           Decimal       @default(0) @db.Decimal(5, 2)
  solicitudCancelacion  Boolean       @default(false)
  solicitudModificacion Json?
  creadoEn              DateTime      @default(now())
  actualizadoEn         DateTime      @updatedAt

  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  items         ItemPedido[]

  @@index([estado])
  @@index([cobrado])
  @@index([creadoEn])
  @@map("pedidos")
}

model ItemPedido {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  productoId  Int
  cantidad    Int
  precioUnit  Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  notas       String?  @db.VarChar(200)

  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  producto    Producto @relation(fields: [productoId], references: [id])

  @@map("items_pedido")
}

model Promocion {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(120)
  descripcion   String?  @db.Text
  imagenUrl     String?  @db.VarChar(300)
  tipo          String   @default("DESCUENTO") @db.VarChar(30)
  valor         Decimal  @default(0) @db.Decimal(10, 2)
  precioOferta  Decimal? @db.Decimal(10, 2)
  productos     Json?
  activa        Boolean  @default(true)
  mostrarMenu   Boolean  @default(true)
  desde         DateTime?
  hasta         DateTime?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([activa, mostrarMenu])
  @@map("promociones")
}

model JuegoConfig {
  id          Int      @id @default(1)
  activo      Boolean  @default(false)
  nombre      String   @default("Ruleta de descuentos") @db.VarChar(100)
  premios     Json
  actualizadoEn DateTime @updatedAt

  @@map("juegos_config")
}


model Apariencia {
  id             Int      @id
  nombre         String   @default("HaceCafe") @db.VarChar(120)
  subtitulo      String   @default("Gastronomía artesanal") @db.VarChar(180)
  bienvenida     String?  @db.Text
  logoUrl        String?  @db.VarChar(500)
  heroBgUrl      String?  @db.VarChar(500)
  colorPrimario  String   @default("#C8913A") @db.VarChar(20)
  colorFondo     String   @default("#0f0d0b") @db.VarChar(20)
  colorCard      String   @default("#1a1712") @db.VarChar(20)
  colorTexto     String   @default("#F0E6D3") @db.VarChar(20)
  fuenteId       String   @default("georgia") @db.VarChar(40)
  actualizadoEn  DateTime @default(now()) @updatedAt @db.DateTime(3)

  @@map("apariencia")
}

model ConfiguracionNegocio {
  id               Int      @id
  rs_nombre        String   @default("HaceCafe") @db.VarChar(150)
  rs_subtitulo     String   @default("Cafetería & Cocina Artesanal") @db.VarChar(180)
  rs_direccion     String?  @db.VarChar(255)
  rs_telefono      String?  @db.VarChar(60)
  rs_cuit          String?  @db.VarChar(60)
  rs_mesas         Int      @default(7)
  rs_dominio       String?  @db.VarChar(500)
  mp_alias         String?  @db.VarChar(150)
  mp_cbu           String?  @db.VarChar(100)
  mp_titular       String?  @db.VarChar(150)
  mp_qr_url        String?  @db.VarChar(500)
  transfer_alias   String?  @db.VarChar(150)
  transfer_cbu     String?  @db.VarChar(100)
  transfer_titular String?  @db.VarChar(150)
  transfer_banco   String?  @db.VarChar(150)
  actualizadoEn    DateTime @default(now()) @updatedAt @db.DateTime(3)

  @@map("configuracion_negocio")
}

enum Rol {
  DUENO @map("DUEÑO")
  EMPLEADO
  COCINA
}

enum EstadoPedido {
  ESPERANDO_APROBACION
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  COBRADO
  CANCELADO
}
