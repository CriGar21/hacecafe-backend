generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id            Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(80)
  icono         String?    @db.VarChar(10)
  activa        Boolean    @default(true)
  ordenDisplay  Int?
  productos     Producto[]

  @@map("categorias")
}

model Producto {
  id                 Int       @id @default(autoincrement())
  categoriaId        Int
  nombre             String    @db.VarChar(120)
  descripcion        String?   @db.Text
  precio             Decimal   @db.Decimal(10, 2)
  precioCosto        Decimal?  @db.Decimal(10, 2)
  disponible         Boolean   @default(true)
  imagenUrl          String?   @db.VarChar(300)
  stockActual        Int       @default(0)
  stockMinimo        Int       @default(5)
  tiempoPreparacion  Int?
  ordenDisplay       Int?
  creadoEn           DateTime  @default(now())
  actualizadoEn      DateTime  @updatedAt

  categoria          Categoria @relation(fields: [categoriaId], references: [id])
  items    ItemPedido[]

  @@index([disponible])
  @@index([categoriaId])
  @@map("productos")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  password     String    @db.VarChar(255)
  rol          Rol       @default(EMPLEADO)
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())
  pedidos      Pedido[]

  @@map("usuarios")
}

model Pedido {
  id            Int           @id @default(autoincrement())
  numero        Int           @unique
  usuarioId     Int
  mesa          String?       @db.VarChar(20)
  estado        EstadoPedido  @default(PENDIENTE)
  cobrado       Boolean       @default(false)
  metodoPago    String?       @db.VarChar(30)
  total         Decimal       @db.Decimal(10, 2)
  notas         String?       @db.Text
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  items         ItemPedido[]

  @@index([estado])
  @@index([cobrado])
  @@index([creadoEn])
  @@map("pedidos")
}

model ItemPedido {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  productoId  Int
  cantidad    Int
  precioUnit  Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  notas       String?  @db.VarChar(200)

  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  producto    Producto @relation(fields: [productoId], references: [id])

  @@map("items_pedido")
}

enum Rol {
  DUEÑO
  EMPLEADO
  COCINA
}

enum EstadoPedido {
  ESPERANDO_APROBACION
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  COBRADO
  CANCELADO
}